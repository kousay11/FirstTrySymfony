{% extends "base.html.twig" %}
{% block title %}Project - Nouvelle recette{% endblock %}
{% block body %}
<div class="container">
<h1 class="mt-4">Creation d'une recette</h1>
{{ form_start(form) }}
    {{ form_start(form) }}

		<div class="form-group">
			{{ form_label(form.name) }}
			{{ form_widget(form.name) }}
			<div class="form-error">
				{{ form_errors(form.name) }}
			</div>
		</div>

		<div class="form-group">
			{{ form_label(form.time) }}
			{{ form_widget(form.time) }}
			<div class="form-error">
				{{ form_errors(form.time) }}
			</div>
		</div>

		<div class="form-group">
			{{ form_label(form.nbPeople) }}
			{{ form_widget(form.nbPeople) }}
			<div class="form-error">
				{{ form_errors(form.nbPeople) }}
			</div>
		</div>

		<div class="form-group">
			{{ form_label(form.difficulty) }}
			{{ form_widget(form.difficulty) }}
			<div class="form-error">
				{{ form_errors(form.difficulty) }}
			</div>
		</div>

		<div class="form-group">
			{{ form_label(form.discription) }}
			{{ form_widget(form.discription) }}
			<div class="form-error">
				{{ form_errors(form.discription) }}
			</div>
		</div>

		<div class="form-group">
			{{ form_label(form.prix) }}
			{{ form_widget(form.prix) }}
			<div class="form-error">
				{{ form_errors(form.prix) }}
			</div>
		</div>

		<div class="form-group mt-4">
			{{ form_widget(form.isFavorite) }}
			{{ form_label(form.isFavorite) }}
			<div class="form-error">
				{{ form_errors(form.isFavorite) }}
			</div>
		</div>
        {{ form_label(form.ingredients) }}

{{ form_end(form) }}
</div>
{% endblock %}